# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=resumewise.example.com
DB_PASSWORD=change-me-long-random
SECRET_KEY=change-me-50-random-characters
ALLOWED_HOSTS=resumewise.example.com
# Email (any SMTP service). Without it, login links and reminders cannot be sent.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ResumeWise <no-reply@resumewise.example.com>
# Who gets "the server broke" emails (comma separated)
ALERT_EMAIL=you@example.com
# Optional
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=14
# Payments (step 15)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
