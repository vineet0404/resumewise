            },
            "description": "Link in the email looks like http://127.0.0.1:8000/#verify=TOKEN",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN-from-the-link-after-#verify=\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
