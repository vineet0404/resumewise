{
  "info": {
    "name": "ResumeWise API v1",
    "description": "Run 'Get CSRF token' first, then Register or Login. The CSRF token is saved automatically from each response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "profile_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "version_id",
      "value": ""
    },
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "health"
              ]
            },
            "description": "Public. Expect {\"status\":\"ok\"}."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Get CSRF token (run first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/auth/csrf",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "csrf"
              ]
            },
            "description": "Sets the csrftoken cookie. Run this first. Postman keeps cookies automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) { pm.collectionVariables.set('csrf', j.csrf); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account and signs you in. name and accept_terms:true are required. Password must pass strength rules.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Your Name\",\n  \"email\": \"you@example.com\",\n  \"password\": \"Strong-pass-77x\",\n  \"accept_terms\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) { pm.collectionVariables.set('csrf', j.csrf); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/forgot",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "forgot"
              ]
            },
            "description": "Always answers the same. Locally, the reset email is printed in the server window. The link looks like http://127.0.0.1:8000/#reset=UID.TOKEN",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) { pm.collectionVariables.set('csrf', j.csrf); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2c. Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "reset"
              ]
            },
            "description": "Use the two parts of the link (after #reset=, split at the first dot). Works once, within 1 hour.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"UID-from-the-link\",\n  \"token\": \"TOKEN-from-the-link\",\n  \"password\": \"Brand-new-pass-91\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) { pm.collectionVariables.set('csrf', j.csrf); }"
                ]
              }
            }
          ]
        },
