              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN-from-the-link-after-#magic=\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
