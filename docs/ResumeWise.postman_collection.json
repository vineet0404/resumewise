    {
      "name": "Resume tools (login needed)",
      "item": [
        {
          "name": "Match score",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/match",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "match"
              ]
            },
            "description": "Returns score, covered terms and missing terms.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resume_text\": \"Aarti Sharma\\n\\nPROJECTS\\n- Tested 12 web modules and logged 60+ defects.\\n- Wrote test cases and defect reports for login and payment pages.\",\n  \"job_text\": \"Required: experience with test cases and defect reporting. Knowledge of Selenium is a plus.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/profiles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "profiles"
              ]
            },
            "description": "Stores parsed resume (auto-deleted after 30 days). Saves id to {{profile_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resume_text\": \"Aarti Sharma\\n\\nPROJECTS\\n- Tested 12 web modules and logged 60+ defects.\\n- Wrote test cases and defect reports for login and payment pages.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('profile_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload resume file (DOCX or TXT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/profiles/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "profiles",
                "upload"
              ]
            },
            "description": "Body > form-data > key 'file' > choose a .docx or .txt file (max 2 MB). PDF is not supported yet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('profile_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/profiles/{{profile_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "profiles",
                "{{profile_id}}"
              ]
            },
            "description": "Only your own profile. Others get 404."
          }
        }
      ]
    },
