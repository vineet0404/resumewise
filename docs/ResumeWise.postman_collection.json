              ],
              "path": [
                "v1",
                "auth",
                "2fa",
                "setup"
              ]
            },
            "description": "Signed in. Returns secret and otpauth uri.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) { pm.collectionVariables.set('csrf', j.csrf); }"
